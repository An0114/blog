# ===== 数据库 =====
# 本地 Docker：postgres:17（容器名 my-pg，端口 5432）
# 复制本文件为 .env 后填写真实值；.env 绝不提交 Git
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/blog

# ===== JWT（PRD A3：7 天有效）=====
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== CORS 白名单（逗号分隔，仅允许你的前端域名，PRD A9）=====
CORS_ORIGINS=http://localhost:5173

# ===== 邮件 SMTP（二期：邮箱验证/找回密码）=====
# 留空时验证/重置链接输出到后端日志（开发模式）；上线前配置真实 SMTP
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_account@qq.com
# SMTP_PASSWORD=授权码
# MAIL_FROM=your_account@qq.com
# FRONTEND_BASE_URL=http://localhost:5173
# EMAIL_TOKEN_EXPIRE_MINUTES=30
