# ===== 容器化部署环境变量模板 =====
# 复制为 .env 后填写：cp .env.example .env
# 数据库 / JWT / CORS / 邮件 全部在此配置，docker compose 自动读取。

# ---- 数据库（首次启动前设置；密码避免使用 URL 特殊字符 @ : / # 等）----
POSTGRES_USER=blog
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=blog

# ---- JWT（必填，缺失时 docker compose 直接报错）----
# 生成：openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=10080

# ---- CORS 白名单（逗号分隔，填你的前端域名，PRD A9）----
CORS_ORIGINS=http://localhost

# ---- 前端（对外端口 + 邮件链接前缀）----
HTTP_PORT=80
FRONTEND_BASE_URL=http://localhost

# ---- 邮件 SMTP（二期：邮箱验证/找回密码；留空时验证/重置链接输出到后端日志）----
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_account@qq.com
# SMTP_PASSWORD=授权码
# MAIL_FROM=your_account@qq.com
# EMAIL_TOKEN_EXPIRE_MINUTES=30
